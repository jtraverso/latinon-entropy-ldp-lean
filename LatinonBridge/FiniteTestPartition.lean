module

/- Finite simultaneous measurable partitions for the Latinon cut-cover proof. -/
public import Graphon.Step

@[expose] public section

noncomputable section

namespace LatinonEntropy

open MeasureTheory
open scoped Classical unitInterval

def finiteTestSignature {K : Type*} (tests : K → Set I) (u : I) : K → Bool :=
  fun k => if u ∈ tests k then true else false

theorem finiteTestSignature_measurable {K : Type*} (tests : K → Set I)
    (h : ∀ k, MeasurableSet (tests k)) : Measurable (finiteTestSignature tests) := by
  apply Measurable.of_eval
  intro k
  exact Measurable.ite (h k) measurable_const measurable_const

/-- The atoms of the finite Boolean algebra generated by the tests.
It covers every point and its cardinality is at most 2 to the number of tests. -/
def finiteTestPartition {K : Type*} [Fintype K] (tests : K → Set I)
    (h : ∀ k, MeasurableSet (tests k)) : MeasurablePartition I volume where
  parts := Finset.univ.image (fun word : K → Bool => finiteTestSignature tests ⁻¹' {word})
  measurable_parts := by
    intro S hS
    obtain ⟨word,_,rfl⟩ := Finset.mem_image.mp hS
    exact (measurableSet_singleton word).preimage (finiteTestSignature_measurable tests h)
  pairwiseDisjoint := by
    intro S hS T hT hne
    obtain ⟨s,_,rfl⟩ := Finset.mem_image.mp hS
    obtain ⟨t,_,rfl⟩ := Finset.mem_image.mp hT
    apply Set.disjoint_left.mpr
    intro u hu hv
    have he : s=t := (Set.mem_singleton_iff.mp hu).symm.trans (Set.mem_singleton_iff.mp hv)
    exact hne (congrArg (fun word => finiteTestSignature tests ⁻¹' {word}) he)
  ae_covers := ae_of_all volume (fun u =>
    ⟨finiteTestSignature tests ⁻¹' {finiteTestSignature tests u},
      Finset.mem_image.mpr ⟨finiteTestSignature tests u,Finset.mem_univ _,rfl⟩,rfl⟩)

theorem finiteTestPartition_card {K : Type*} [Fintype K] (tests : K → Set I)
    (h : ∀ k, MeasurableSet (tests k)) :
    (finiteTestPartition tests h).parts.card ≤ 2^Fintype.card K := by
  exact (Finset.card_image_le).trans_eq (by simp)

theorem finiteTestPartition_decides {K : Type*} [Fintype K] (tests : K → Set I)
    (h : ∀ k, MeasurableSet (tests k)) (S : Set I)
    (hS : S ∈ (finiteTestPartition tests h).parts) (k : K) :
    S ⊆ tests k ∨ S ⊆ (tests k)ᶜ := by
  obtain ⟨word,_,rfl⟩ := Finset.mem_image.mp hS
  cases hw : word k with
  | false =>
    right
    intro u hu
    have he := congrArg (fun s : K → Bool => s k) (Set.mem_singleton_iff.mp hu)
    rw [hw] at he
    intro hmem
    simp [finiteTestSignature,hmem] at he
  | true =>
    left
    intro u hu
    have he := congrArg (fun s : K → Bool => s k) (Set.mem_singleton_iff.mp hu)
    rw [hw] at he
    by_contra hnot
    simp [finiteTestSignature,hnot] at he

end LatinonEntropy

